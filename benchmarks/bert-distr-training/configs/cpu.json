{
  "model": "bert-base-cased",
  "dataset": "yelp_review_full",
  "samples": 32000,
  "validation_samples": 3200,
  "epochs": 3,
  "max_sequence_length": 128,
  "train_batch_size": 8,
  "eval_batch_size": 16,
  "gradient_accumulation_steps": 1,
  "learning_rate": 0.00005,
  "weight_decay": 0.0,
  "warmup_ratio": 0.0,
  "seed": 42,
  "tokenizer_processes": 8,
  "dataloader_workers": 4,
  "cpu_threads": 32,
  "memory_gib": 64,
  "nodes": 10,
  "processes_per_node": 1,
  "gpus_per_node": 0,
  "device": "cpu",
  "evaluate": true,
  "save_model": true,
  "log_steps": 20,
  "distributed_timeout_seconds": 600
}
