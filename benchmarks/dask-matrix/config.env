# Shared workload defaults. Override any value in the environment.
DASK_VERSION="${DASK_VERSION:-2024.1.0}"
IMAGE_REPOSITORY="${IMAGE_REPOSITORY:-dask-matrix}"
IMAGE_TAG="${IMAGE_TAG:-2024.1.0-amd64-r2}"
IMAGE_NAME="${IMAGE_NAME:-${IMAGE_REPOSITORY}:${IMAGE_TAG}}"
DASK_SIF="${DASK_SIF:-${HOME}/.skiff/images/dask-matrix-2024.1.0-amd64-r2.sif}"

# One worker per node. These fixed-work defaults are an unmeasured starting
# point for roughly ten minutes on ten large CPU nodes; tune from a pilot.
WORKERS="${WORKERS:-10}"
MATRIX_SIZE="${MATRIX_SIZE:-24000}"
CHUNK_SIZE="${CHUNK_SIZE:-4000}"
ITERATIONS="${ITERATIONS:-40}"
RANDOM_SEED_A="${RANDOM_SEED_A:-42}"
RANDOM_SEED_B="${RANDOM_SEED_B:-43}"

# Every worker runs one Dask task at a time and lets BLAS use a controlled CPU
# subset. This avoids treating a whole-node allocation as an implicit budget.
WORKER_THREADS="${WORKER_THREADS:-1}"
BLAS_THREADS="${BLAS_THREADS:-32}"
WORKER_CPU="${WORKER_CPU:-32}"
WORKER_MEMORY_GIB="${WORKER_MEMORY_GIB:-32}"
SCHEDULER_CPU="${SCHEDULER_CPU:-2}"
SCHEDULER_MEMORY_GIB="${SCHEDULER_MEMORY_GIB:-4}"
CLIENT_CPU="${CLIENT_CPU:-4}"
CLIENT_MEMORY_GIB="${CLIENT_MEMORY_GIB:-8}"

REQUIRE_ALL_WORKERS="${REQUIRE_ALL_WORKERS:-true}"
REQUIRE_DISTINCT_NODES="${REQUIRE_DISTINCT_NODES:-true}"
STARTUP_TIMEOUT_SECONDS="${STARTUP_TIMEOUT_SECONDS:-300}"
CPU_SAMPLE_INTERVAL_SECONDS="${CPU_SAMPLE_INTERVAL_SECONDS:-0.5}"
POLL_SECONDS="${POLL_SECONDS:-5}"

# Deployment paths remain generic and explicitly overridable.
NAMESPACE="${NAMESPACE:-dask-matrix}"
DASK_CHART_VERSION="${DASK_CHART_VERSION:-2024.1.1}"
RESULTS_HOST_PATH="${RESULTS_HOST_PATH:-${HOME}/.skiff/results/dask-matrix}"
RESULTS_POD_HOST_PATH="${RESULTS_POD_HOST_PATH:-/root/.skiff/results/dask-matrix}"
SLURM_TIME="${SLURM_TIME:-01:00:00}"
