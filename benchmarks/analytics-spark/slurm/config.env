# shellcheck shell=bash
# Load the shared workload before applying platform-specific defaults.
# shellcheck source=../config.env
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config.env"

# Same immutable application image as the shared benchmark.
SPARK_SIF="${SPARK_SIF:-${SPARK_IMAGE_HOST_PATH}}"
MINIO_CORES="${MINIO_CORES:-4}"
MINIO_MEMORY="${MINIO_MEMORY:-8g}"
# Keep MinIO on the shared home filesystem, like Skiff's directory-backed emptyDir.
MINIO_DATA_ROOT="${MINIO_DATA_ROOT:-${HOME}/.skiff/benchmark-data/analytics-spark-slurm}"
SPARK_INTERFACE="${SPARK_INTERFACE:-enp5s0f0}"
CPU_BIND="${CPU_BIND:-cores}"
STARTUP_TIMEOUT_SECONDS="${STARTUP_TIMEOUT_SECONDS:-120}"
MASTER_PORT="${MASTER_PORT:-7077}"
MASTER_UI_PORT="${MASTER_UI_PORT:-8080}"
WORKER_PORT="${WORKER_PORT:-7078}"
WORKER_UI_PORT="${WORKER_UI_PORT:-8081}"
MINIO_PORT="${MINIO_PORT:-9000}"
MINIO_CONSOLE_PORT="${MINIO_CONSOLE_PORT:-9001}"
