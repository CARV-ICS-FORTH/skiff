# shellcheck shell=bash
# Load the shared workload before applying platform-specific defaults.
# shellcheck source=../config.env
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config.env"

# Kubernetes and Spark Operator
NAMESPACE="${NAMESPACE:-analytics-spark-knot}"
OPERATOR_RELEASE="${OPERATOR_RELEASE:-spark-knot-operator}"
OPERATOR_CHART_VERSION="${OPERATOR_CHART_VERSION:-2.5.2}"
SERVICE_ACCOUNT="${SERVICE_ACCOUNT:-spark-knot-runner}"
INSTALL_OPERATOR="${INSTALL_OPERATOR:-true}"
DISABLE_OPERATOR_PROBES="${DISABLE_OPERATOR_PROBES:-true}"

# One immutable SIF contains Spark, the benchmark, TPC-DS tools, S3A, MinIO, and mc.
SPARK_IMAGE="${SPARK_IMAGE:-/var/lib/skiff/images/analytics-spark-knot-${SPARK_VERSION}-amd64-${IMAGE_REVISION}${IMAGE_MODE_SUFFIX}.sif}"
IMAGE_PULL_POLICY="${IMAGE_PULL_POLICY:-Never}"
MAIN_APPLICATION_FILE="${MAIN_APPLICATION_FILE:-local:///opt/spark/work-dir/benchmark.py}"
APP_NAME_PREFIX="${APP_NAME_PREFIX:-spark-knot}"

# Disposable S3-compatible storage. Data remains until the MinIO pod is replaced.
MINIO_NAME="${MINIO_NAME:-spark-knot-minio}"
MINIO_SECRET="${MINIO_SECRET:-spark-knot-object-store}"
MINIO_CPU_REQUEST="${MINIO_CPU_REQUEST:-1}"
MINIO_CPU_LIMIT="${MINIO_CPU_LIMIT:-4}"
MINIO_MEMORY_REQUEST="${MINIO_MEMORY_REQUEST:-2Gi}"
MINIO_MEMORY_LIMIT="${MINIO_MEMORY_LIMIT:-8Gi}"

# One executor per distinct node; the shared profile selects the count.
DRIVER_CORE_LIMIT="${DRIVER_CORE_LIMIT:-${DRIVER_CORES}000m}"
EXECUTOR_CORE_LIMIT="${EXECUTOR_CORE_LIMIT:-${EXECUTOR_CORES}000m}"

POLL_SECONDS="${POLL_SECONDS:-5}"
RESULTS_DIR="${RESULTS_DIR:-}"
