# shellcheck shell=bash
# Initial fixed-work estimate for ten nodes, four executor cores/node.
# Calibrate at this scale/resources before claiming a measured one-hour run.
SCALE_FACTOR="${SCALE_FACTOR:-10}"
GENERATION_PARTITIONS="${GENERATION_PARTITIONS:-80}"
SHUFFLE_PARTITIONS="${SHUFFLE_PARTITIONS:-80}"
QUERY_ITERATIONS="${QUERY_ITERATIONS:-8}"
EXECUTOR_INSTANCES="${EXECUTOR_INSTANCES:-10}"
SPARK_INTERFACE="${SPARK_INTERFACE:-ib0}"
GENERATION_TIMEOUT_SECONDS="${GENERATION_TIMEOUT_SECONDS:-3600}"
QUERY_TIMEOUT_SECONDS="${QUERY_TIMEOUT_SECONDS:-7200}"
