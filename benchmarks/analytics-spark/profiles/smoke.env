# shellcheck shell=bash
# Original small workload, also suitable for validation and local preparation.
SCALE_FACTOR="${SCALE_FACTOR:-1}"
GENERATION_PARTITIONS="${GENERATION_PARTITIONS:-24}"
SHUFFLE_PARTITIONS="${SHUFFLE_PARTITIONS:-24}"
QUERY_ITERATIONS="${QUERY_ITERATIONS:-3}"
EXECUTOR_INSTANCES="${EXECUTOR_INSTANCES:-3}"
SPARK_INTERFACE="${SPARK_INTERFACE:-enp5s0f0}"
GENERATION_TIMEOUT_SECONDS="${GENERATION_TIMEOUT_SECONDS:-1800}"
QUERY_TIMEOUT_SECONDS="${QUERY_TIMEOUT_SECONDS:-3600}"
