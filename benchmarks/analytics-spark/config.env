# shellcheck shell=bash
# Shared image, workload and resource defaults for Skiff and native Slurm.
# Every setting can be overridden through the environment.
WORKLOAD_PROFILE="${WORKLOAD_PROFILE:-hour}"
BENCHMARK_MODE="${BENCHMARK_MODE:-cpu}"
case "$WORKLOAD_PROFILE" in
    hour|smoke)
        # shellcheck source=/dev/null
        source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/profiles/${WORKLOAD_PROFILE}.env"
        ;;
    *) echo "WORKLOAD_PROFILE must be hour or smoke" >&2; return 1 ;;
esac
case "$BENCHMARK_MODE" in
    cpu) IMAGE_MODE_SUFFIX=; DEFAULT_EXECUTOR_OVERHEAD=2g ;;
    gpu) IMAGE_MODE_SUFFIX=-gpu; DEFAULT_EXECUTOR_OVERHEAD=4g ;;
    *) echo "BENCHMARK_MODE must be cpu or gpu" >&2; return 1 ;;
esac
SPARK_VERSION="${SPARK_VERSION:-4.0.4}"
IMAGE_REVISION="${IMAGE_REVISION:-r2}"
SPARK_IMAGE_HOST_PATH="${SPARK_IMAGE_HOST_PATH:-${HOME}/.skiff/images/analytics-spark-knot-${SPARK_VERSION}-amd64-${IMAGE_REVISION}${IMAGE_MODE_SUFFIX}.sif}"
MINIO_BUCKET="${MINIO_BUCKET:-spark-knot}"
QUERY_SET="${QUERY_SET:-original}"
DRIVER_CORES="${DRIVER_CORES:-4}"
DRIVER_MEMORY="${DRIVER_MEMORY:-4g}"
DRIVER_MEMORY_OVERHEAD="${DRIVER_MEMORY_OVERHEAD:-1g}"
EXECUTOR_CORES="${EXECUTOR_CORES:-4}"
EXECUTOR_MEMORY="${EXECUTOR_MEMORY:-8g}"
EXECUTOR_MEMORY_OVERHEAD="${EXECUTOR_MEMORY_OVERHEAD:-$DEFAULT_EXECUTOR_OVERHEAD}"
# One GPU/executor; fractional task reservation keeps the all-slot barrier schedulable.
RAPIDS_VERSION="${RAPIDS_VERSION:-26.08.1}"
GPU_TASK_AMOUNT="${GPU_TASK_AMOUNT:-$(awk -v cores="$EXECUTOR_CORES" 'BEGIN {if (cores > 0) printf "%.17g", 1/cores; else print 0}')}"
GPU_CONCURRENT_TASKS="${GPU_CONCURRENT_TASKS:-$(awk -v cores="$EXECUTOR_CORES" 'BEGIN {print (cores < 2 ? cores : 2)}')}"
GPU_PINNED_POOL="${GPU_PINNED_POOL:-1g}"
# Hour-scale suites can exceed the old 1000-stage retention limit.
UI_RETAINED_JOBS="${UI_RETAINED_JOBS:-10000}"
UI_RETAINED_STAGES="${UI_RETAINED_STAGES:-50000}"
